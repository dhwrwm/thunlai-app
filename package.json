{
  "name": "thunlai",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@thunlai/web",
    "dev:admin": "turbo dev --filter=@thunlai/admin",
    "dev:mobile": "turbo dev --filter=@thunlai/mobile",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:seed": "node --experimental-strip-types --env-file=.env packages/db/scripts/seed-neon.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  }
}
